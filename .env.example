# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า — ห้าม commit .env
# ค่าเหล่านี้ใช้กับ docker-compose (postgres) สำหรับ local dev เท่านั้น

POSTGRES_USER=beps
POSTGRES_PASSWORD=beps_dev_only
POSTGRES_DB=beps
POSTGRES_PORT=5432

# apps/api จะใช้ค่านี้ (สร้างใน Sprint 2)
# DATABASE_URL="postgresql://beps:beps_dev_only@localhost:5432/beps?schema=public"
