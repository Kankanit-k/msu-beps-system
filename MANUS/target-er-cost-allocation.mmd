erDiagram
    TIME_PERIOD ||--o{ REGISTRATION_SNAPSHOT : scopes
    TIME_PERIOD ||--o{ ERP_COST_TRANSACTION : scopes
    TIME_PERIOD ||--o{ FEE_TRANSACTION : scopes
    ORG_UNIT ||--o{ ORG_UNIT_MAP : maps
    ORG_UNIT ||--o{ PROGRAM_ORG_MAP : owns
    PROGRAM ||--o{ PROGRAM_VERSION : has
    PROGRAM_VERSION ||--o{ PROGRAM_ORG_MAP : assigned
    PROGRAM_VERSION ||--o{ REGISTRATION_SNAPSHOT : counts
    ERP_ACCOUNT_HIERARCHY ||--o{ BUDGET_CATEGORY_MAP : classifies
    ERP_COST_TRANSACTION }o--|| ERP_ACCOUNT_HIERARCHY : uses
    ERP_COST_TRANSACTION }o--|| ORG_UNIT : incurred_by
    BUDGET_CATEGORY_MAP ||--o{ ALLOCATION_METHOD : uses
    ALLOCATION_METHOD ||--o{ ALLOCATION_DRIVER : defines
    ALLOCATION_METHOD ||--o{ ALLOCATION_RUN : executed_as
    ALLOCATION_RUN ||--o{ ALLOCATION_RESULT : produces
    ERP_COST_TRANSACTION ||--o{ ALLOCATION_RESULT : allocated_from
    PROGRAM_VERSION ||--o{ ALLOCATION_RESULT : allocated_to
    TIME_PERIOD ||--o{ ALLOCATION_RUN : runs_for
    PROGRAM_VERSION ||--o{ PROGRAM_COST_SUMMARY : summarizes
