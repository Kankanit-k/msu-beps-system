# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASEPATH=http://localhost:3000
BASEPATH=

# -----------------------------------------------------------------------------
# Access control (src/middleware.ts + src/configs/accessControl.ts)
# -----------------------------------------------------------------------------
# Local-dev escape hatch: set to true to skip auth/role checks while developing.
# ใช้ได้เฉพาะ dev กับ preview — src/configs/authBypass.ts บังคับปิดเมื่อ VERCEL_ENV=production
# ไม่ว่าจะตั้งค่านี้ไว้ยังไงก็ตาม
AUTH_DISABLED=false
# Same switch for the client (src/@layouts/LayoutWrapper.tsx) — middleware is server-side
# only, so without this the layout still bounces you to ERP. Keep the two in sync.
NEXT_PUBLIC_AUTH_DISABLED=${AUTH_DISABLED}

# -----------------------------------------------------------------------------
# NextAuth + ERP-MSU OAuth (src/libs/ErpAuth.ts, src/app/api/auth/[...nextauth])
# -----------------------------------------------------------------------------
# Ask the ERP-MSU integration owner for these — used to sign in via https://erp.msu.ac.th
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Random secret NextAuth uses to sign/encrypt the session JWT — generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
# Base URL NextAuth uses for callbacks — must match where this app is actually served
NEXTAUTH_URL=http://localhost:3000
# Fallback origin for the backend API (apps/api, Sprint 2) — used by src/app/(private)/users
NEXT_PUBLIC_SERVER_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Logging (src/libs/logger) — daily files + Discord error alerts
# -----------------------------------------------------------------------------
LOG_ENABLED=true
# debug | info | warn | error | fatal
LOG_LEVEL=debug
# Directory for the daily files: <dir>/app-YYYY-MM-DD.log และ <dir>/error-YYYY-MM-DD.log
LOG_DIR=logs
LOG_FILE_PREFIX=app
LOG_TIMEZONE=Asia/Bangkok
# Files older than this many days are deleted automatically (0 = keep forever)
LOG_RETENTION_DAYS=30
# Mirror logs to the console as well
LOG_CONSOLE=true
# Indent the JSON in the file (easier to read by hand, harder to grep)
LOG_PRETTY=false
# Max client-side log posts accepted per IP per minute (/api/log)
LOG_CLIENT_MAX_PER_MINUTE=60

# Discord webhook — paste the URL here when you have it; nothing else needs changing.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_ENABLED=true
# Minimum level that triggers a Discord alert
DISCORD_WEBHOOK_LEVEL=error
DISCORD_WEBHOOK_USERNAME=MSU App Logger
# Optional mention for fatal alerts, e.g. <@&123456789012345678>
DISCORD_WEBHOOK_MENTION=
DISCORD_WEBHOOK_ENVIRONMENT=development
# ช่องทางที่ webhook อยู่: ตั้ง true ถ้าเป็น **forum channel** (Discord บังคับว่าทุกข้อความ
# ต้องอยู่ในโพสต์ — ระบบจะเปิดโพสต์ใหม่ตั้งชื่อตาม error และ error เดิมจะตอบกลับเข้าโพสต์เดิม)
DISCORD_WEBHOOK_FORUM=false
# ส่งทุก alert เข้าโพสต์/เธรดเดิมอันเดียว (คลิกขวาที่โพสต์ → Copy Link → เอา id ท้ายสุด)
# ตั้งค่านี้แล้วจะไม่เปิดโพสต์ใหม่เลย และใช้ได้กับ text channel ที่มีเธรดด้วย
DISCORD_WEBHOOK_THREAD_ID=
# ติด tag ให้โพสต์ที่เปิดใหม่ในฟอรั่ม (คั่นด้วยจุลภาค) — ไม่ใส่ก็ได้
DISCORD_WEBHOOK_TAG_IDS=
# Suppress duplicate alerts of the same error within this window (ms)
DISCORD_WEBHOOK_DEDUPE_MS=60000
DISCORD_WEBHOOK_MAX_PER_MINUTE=20
