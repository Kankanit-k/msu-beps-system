{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'ไม่ต้องติดตั้ง — mockup เป็น static ล้วน'",
  "buildCommand": "echo 'ไม่ต้อง build — เสิร์ฟ mockup/ ตรงๆ'",
  "outputDirectory": "mockup",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/W1-overview",
      "permanent": false
    }
  ],
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
